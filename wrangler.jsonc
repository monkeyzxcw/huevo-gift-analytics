{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "huevo-gift-analytics",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-29",
  "assets": {
    "directory": "./cloudflare-site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/data.json",
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "huevo-live-data",
      "database_id": "a017ffdc-c4c5-46c7-8a86-d67bd70cff4f",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "0 * * * *"
    ]
  }
}
