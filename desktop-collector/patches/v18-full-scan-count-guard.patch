+def test_full_snapshot_accepts_smaller_catalog_after_confirmed_full_pass():
+    from datetime import datetime, timezone
+
+    now = datetime.now(timezone.utc).isoformat()
+    previous = {
+        "schema_version": 3,
+        "generated_at": now,
+        "lots": [
+            {"lot_id": str(i), "title": f"Gift {i}", "price": 100 + i,
+             "active": True, "first_seen": now, "last_seen": now,
+             "history": [{"observed_at": now, "price": 100 + i}]}
+            for i in range(1, 392)
+        ],
+        "gone_lots": [], "catalog_events": [], "snapshots": []
+    }
+    current_rows = [
+        {"lot_id": str(i), "title": f"Gift {i}", "price": 90 + i}
+        for i in range(1, 65)
+    ]
+
+    snapshot = module._build_full_snapshot(current_rows, previous, 13)
+
+    assert len([lot for lot in snapshot["lots"] if lot.get("active")]) == 64
+    assert len(snapshot["gone_lots"]) == 327
+    first = next(lot for lot in snapshot["lots"] if lot["lot_id"] == "1")
+    assert first["history"][0] == {"observed_at": now, "price": 101}
+    assert first["history"][-1]["price"] == 91
+    assert all(not lot.get("active", True) for lot in snapshot["gone_lots"])
