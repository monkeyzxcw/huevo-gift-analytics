# Example only. Copy to .env before running Docker Compose. Never commit real secrets.
# Never commit a real .env, cookie exports, tokens or secrets.
INGEST_TOKEN=replace-with-a-long-random-secret
# Huevo primary domain; use the alternate host only if it is the one that accepts your login.
HUEVO_BASE_URL=https://huevo.su
# Optional server-side session. Set a single-line JSON cookie array if using Docker auto-crawl.
# Keep the value private; do not paste it into GitHub or chat.
# HUEVO_COOKIES_JSON='[{"name":"example","value":"replace-me","domain":"huevo.su","path":"/","secure":true}]'
# Alternative: HUEVO_COOKIES=... (raw Netscape export is awkward in .env; JSON is recommended).
# Docker Compose overrides this to /data/huevo.db on a persistent named volume.
HUEVO_DB=/data/huevo.db
CRAWL_DELAY=2.0
CRAWL_BLOCK_COOLDOWN_HOURS=6
MAX_PAGES=500
AUTO_REFRESH_HOURS=2
DIAG_COOLDOWN_SECONDS=300
LOG_LEVEL=INFO

# Support-the-author payments (huEVO Apps): keys from the app's "Ключи доступа" tab.
# The secret stays on the server. Callback URL in the app settings: /api/support/callback
# HUEVO_CLIENT_ID=
# HUEVO_CLIENT_SECRET=
