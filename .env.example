# Example only. Copy to .env locally; set real values in Render Environment.
# Never commit your real .env or production secrets.
INGEST_TOKEN=replace-with-a-long-random-secret
# Huevo primary domain; use the alternate host only if it is the one that accepts your login.
HUEVO_BASE_URL=https://huevo.su
# Optional: complete vless:// subscription-node URI. Store only in Render Environment/.env, never in GitHub.
# VLESS_URL=
# Cookie export formats: JSON (HUEVO_COOKIES_JSON) or Netscape cookies.txt (HUEVO_COOKIES).
# Never commit real cookie exports: they can grant access to your account.
# HUEVO_COOKIES_JSON=
# HUEVO_COOKIES=
# Local SQLite path. On Render, use a persistent disk if configured.
HUEVO_DB=huevo.db
CRAWL_DELAY=2.2
CRAWL_BLOCK_COOLDOWN_HOURS=6
MAX_PAGES=500
