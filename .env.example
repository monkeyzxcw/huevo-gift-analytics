# Example only. Copy to .env locally; set real values in Render -> Environment.
# Never commit a real .env, cookie exports, tokens or secrets.
INGEST_TOKEN=replace-with-a-long-random-secret
# Huevo primary domain; use the alternate host only if it is the one that accepts your login.
HUEVO_BASE_URL=https://huevo.su
# Optional server-side session (otherwise use the browser collector). JSON or Netscape cookies.txt:
# HUEVO_COOKIES_JSON=
# HUEVO_COOKIES=
# Local SQLite path. On Render use a persistent disk path, e.g. /var/data/huevo.db (paid option).
HUEVO_DB=huevo.db
CRAWL_DELAY=2.0
CRAWL_BLOCK_COOLDOWN_HOURS=6
MAX_PAGES=500
AUTO_REFRESH_HOURS=2
DIAG_COOLDOWN_SECONDS=300
LOG_LEVEL=INFO

# Support-the-author payments (huEVO Apps): keys from the app's "Ключи доступа" tab.
# The secret stays on the server. Callback URL in the app settings: /api/support/callback
# HUEVO_CLIENT_ID=
# HUEVO_CLIENT_SECRET=
